APP_NAME=ReflexCMS
APP_ENV=local
APP_KEY=
APP_DEBUG=true

LOG_CHANNEL=stack
LOG_LEVEL=debug

APP_URL=http://localhost:9000
APP_HOST=127.0.0.1
APP_PORT=9000

# Cache / Queue
CACHE_STORE=redis
QUEUE_CONNECTION=sync

SESSION_DRIVER=file
SESSION_LIFETIME=120

JWT_SECRET=

# PostgreSQL (defaults match deploy/docker-compose.yml; use service names
# postgres/redis when running the backend itself inside the compose network)
DB_CONNECTION=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=reflexcms
DB_USERNAME=reflexcms
DB_PASSWORD=secret
DB_SCHEMA=public

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# AI providers stay empty until the AI module is enabled (plan O8)
AI_PROVIDER=
OPENAI_API_KEY=
OPENAI_BASE_URL=

MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=
